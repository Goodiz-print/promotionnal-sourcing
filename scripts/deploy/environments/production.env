# Paramètres de l'environnement PRODUCTION, lus par scripts/deploy/clever_provision.sh.
# Aucun secret ici : ce fichier est committé.

# Organisation Clever Cloud : une seule pour tous les environnements (ADR 0005).
CLEVER_ORG='Promotional Sourcing'
# Préfixe des ressources : <préfixe>-web, -worker, -pg, -cellar.
APP_PREFIX=ps-prod
REGION=par

# Domaine public de l'application web (sans schéma). Domaine nu : DNS par
# enregistrements A, cf. docs/deploiement-clever-setup.md. Ne pas le changer
# après l'ouverture : cela invalide les passkeys enregistrées.
APP_DOMAIN=promotional-sourcing.eu

# Dimensionnement de l'ADR 0003.
WEB_FLAVOR=XS
WEB_INSTANCES=2
WORKER_FLAVOR=XS

# Plan PostgreSQL « S Big Space » : identifiant à vérifier avec
#   clever addon providers show postgresql-addon
PG_PLAN=s_big
PG_VERSION=18

# Bucket Cellar dédié à l'environnement (à créer une fois, cf. docs/storage.md).
CELLAR_BUCKET=promotionnal-sourcing-prod

MAIL_FROM_ADDRESS=noreply@promotional-sourcing.eu
MAIL_FROM_NAME=PromotionalSourcing
LOG_LEVEL=info
