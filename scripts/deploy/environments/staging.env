# Paramètres de l'environnement STAGING, lus par scripts/deploy/clever_provision.sh.
# Aucun secret ici : ce fichier est committé.

# Organisation Clever Cloud hors production (staging + reviews).
CLEVER_ORG=goodiz-nonprod
# Préfixe des ressources : <préfixe>-web, -worker, -pg, -cellar.
APP_PREFIX=ps-staging
REGION=par

# Domaine public de l'application web (sans schéma).
APP_DOMAIN=ps-staging.cleverapps.io

# Une seule instance web : le staging valide le code, pas la tenue en charge.
WEB_FLAVOR=XS
WEB_INSTANCES=1
WORKER_FLAVOR=XS

# Plan PostgreSQL : identifiant à vérifier avec
#   clever addon providers show postgresql-addon
PG_PLAN=xs_sml
PG_VERSION=18

# Bucket Cellar dédié à l'environnement (à créer une fois, cf. docs/storage.md).
CELLAR_BUCKET=promotionnal-sourcing-staging

MAIL_FROM_ADDRESS=noreply@promotional-sourcing.eu
MAIL_FROM_NAME='PromotionalSourcing (staging)'
LOG_LEVEL=info
