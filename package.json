{
  "name": "promotionnal-sourcing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "dev:all": "bash scripts/dev.sh",
    "test": "node ace test",
    "test:db": "docker compose --profile test up -d postgres_test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --project inertia/tsconfig.json",
    "test:inertia": "vitest run",
    "prepare": "husky"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#jobs/*": "./app/jobs/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#shared/*": "./shared/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/browser-client": "^2.3.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.4.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "~25.9.9",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.6",
    "hot-hook": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/inertia": "^5.0.5",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/queue": "^0.6.2",
    "@adonisjs/session": "^8.3.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/transmit": "^3.0.2",
    "@adonisjs/transmit-client": "^1.1.0",
    "@adonisjs/vite": "^6.0.4",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@boringnode/bus": "0.9.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@inertiajs/vue3": "^3.9.1",
    "@mistralai/mistralai": "^3.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@tuyau/core": "^1.2.3",
    "@vinejs/vine": "^4.4.0",
    "@vue/server-renderer": "3.5.44",
    "edge.js": "^6.5.1",
    "intl-messageformat": "^11.2.15",
    "luxon": "^3.7.2",
    "meilisearch": "0.62.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "0.35.5",
    "vue": "3.5.44",
    "vue-sonner": "^2.0.9"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config",
  "lint-staged": {
    "*.{ts,js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,edge,md}": "prettier --write"
  }
}
