# Dependencies and AdonisJS build
node_modules
build
tmp/*
!tmp/.gitkeep

# Code généré par l'assembler AdonisJS (régénéré par `ace serve` / `ace build` / `ace test`)
# NB : database/schema.ts est aussi généré, mais reste versionné — sa regénération
# (`ace schema:generate`) exige une base de données, indisponible dans les jobs CI lint/build.
.adonisjs

# Secrets
.env
.env.local
.env.production.local
.env.development.local

# Frontend assets compiled code
public/assets

# Build tools specific
npm-debug.log
yarn-error.log

# Editors specific
.fleet
.idea
.vscode

# Platform specific
.DS_Store
