SESSION_DRIVER=memory
# Les jobs s'exécutent immédiatement, dans le process de test : les mails mis en
# queue par les controllers sont donc réellement « envoyés » et observables via
# `mail.fake()` — sans worker ni table `queue_jobs`. Aligné sur la CI.
QUEUE_DRIVER=sync

# Base de test dédiée, servie par le service `postgres_test` du
# docker-compose (profil `test`, port 5441, données en tmpfs) :
#
#   pnpm test:db && pnpm test
#
# Ces valeurs écrasent celles de `.env` (ordre de chargement AdonisJS :
# .env.test.local → .env.test → .env) mais restent écrasées par de vraies
# variables d'environnement — la CI passe donc les siennes sans conflit.
DB_HOST=127.0.0.1
DB_PORT=5441
DB_USER=test
DB_PASSWORD=test
DB_DATABASE=test
LOG_LEVEL=error

# Cellar : valeurs factices — les tests remplacent `StorageDriver` par un faux
# (`container.swap`), aucun appel réseau n'est émis.
CELLAR_ENDPOINT=cellar.test
CELLAR_BUCKET=test
CELLAR_ACCESS_KEY_ID=test
CELLAR_SECRET_ACCESS_KEY=test

# Les compteurs vivent en mémoire : pas de table `rate_limits` à semer, et la
# suite les remet à zéro entre deux tests (cf. `tests/utils/setup.ts`).
LIMITER_STORE=memory
