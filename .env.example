# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
QUEUE_DRIVER=database

# Database (PostgreSQL + pgvector requis pour le catalogue/recherche)
# DB_CONNECTION: laisser vide en dev (pg par defaut) ; mettre `pg` en test.
DB_CONNECTION=
DB_HOST=127.0.0.1
DB_PORT=5430
DB_USER=promotionnal-sourcing
DB_PASSWORD=promotionnal-sourcing
DB_DATABASE=promotionnal-sourcing_dev

# Mail (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM_ADDRESS=noreply@promotionalsourcing.eu
MAIL_FROM_NAME=PromotionalSourcing

# Cloudinary (upload et hébergement des images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# IA (Mistral) — embeddings produits pour la recherche sémantique
# Laisser AI_EMBEDDINGS_ENABLED vide/false en dev/test (aucun appel réseau).
# En production : AI_EMBEDDINGS_ENABLED=true + MISTRAL_API_KEY renseigné.
MISTRAL_API_KEY=
AI_EMBEDDINGS_ENABLED=false