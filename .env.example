# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
QUEUE_DRIVER=database

# Database (PostgreSQL + pgvector requis pour le catalogue/recherche)
DB_HOST=127.0.0.1
DB_PORT=5430
DB_USER=promotionnal-sourcing
DB_PASSWORD=promotionnal-sourcing
DB_DATABASE=promotionnal-sourcing_dev

# Mail (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM_ADDRESS=noreply@promotionalsourcing.eu
MAIL_FROM_NAME=PromotionalSourcing

# Cellar (Clever Cloud, API S3) — stockage des fichiers
# En dev : S3 local (S3Mock) (`docker compose up -d`, crée le bucket ci-dessous).
# En production : valeurs de l'add-on Cellar (CELLAR_ADDON_HOST — hôte nu ou URL —,
# CELLAR_ADDON_KEY_ID, CELLAR_ADDON_KEY_SECRET) ; le bucket est à créer au préalable.
CELLAR_ENDPOINT=http://localhost:9090
CELLAR_BUCKET=promotionnal-sourcing-dev
CELLAR_ACCESS_KEY_ID=dev
CELLAR_SECRET_ACCESS_KEY=dev

# IA — embeddings produits pour la recherche sémantique
# Laisser AI_EMBEDDINGS_ENABLED vide/false en dev/test (aucun appel réseau).
# En production : AI_EMBEDDINGS_ENABLED=true + le provider choisi configuré.
AI_EMBEDDINGS_ENABLED=false

# Provider d'embeddings : "mistral" (natif) ou "openai-compatible" (générique).
AI_PROVIDER=mistral

# Driver Mistral (AI_PROVIDER=mistral)
MISTRAL_API_KEY=
MISTRAL_EMBED_MODEL=mistral-embed

# Driver OpenAI-compatible (AI_PROVIDER=openai-compatible) :
# OpenAI, Together, Groq, Ollama, vLLM, LM Studio… (protocole /embeddings).
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_EMBED_MODEL=text-embedding-3-small

# Rate limiting (login, inscription, mot de passe oublié) : `database` (table
# `rate_limits`, partagée entre instances) ou `memory` (tests, process unique).
LIMITER_STORE=database

# Passkeys (WebAuthn) — optionnel : dérivé de APP_URL par défaut.
# PASSKEY_RP_ID est le domaine (sans schéma ni port), PASSKEY_ORIGIN l'origine complète.
# Changer le RP ID invalide toutes les passkeys déjà enregistrées.
# PASSKEY_RP_ID=
# PASSKEY_ORIGIN=
