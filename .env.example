# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
QUEUE_DRIVER=database

# Temps réel : `memory` (défaut, une instance) ou `postgres` (plusieurs instances web).
# TRANSMIT_TRANSPORT=memory

# Database (PostgreSQL + pgvector requis pour le catalogue/recherche)
DB_HOST=127.0.0.1
DB_PORT=5440
DB_USER=promotionnal-sourcing
DB_PASSWORD=promotionnal-sourcing
DB_DATABASE=promotionnal-sourcing_dev

# Mail (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM_ADDRESS=noreply@promotionalsourcing.eu
MAIL_FROM_NAME=PromotionalSourcing
# Destinataire des alertes d'échec définitif d'un mail transactionnel (vide = log seul)
MAIL_ALERT_ADDRESS=

# Supervision (#179). Jeton du point d'entrée GET /health/details (vide = point d'entrée désactivé)
HEALTH_TOKEN=
# Seuils (valeurs par défaut) : délai d'une sonde, lenteur, mails en échec/heure, passes avant alerte
# HEALTH_PROBE_TIMEOUT_MS=3000
# HEALTH_SLOW_MS=1500
# HEALTH_MAIL_FAILED_THRESHOLD=5
# HEALTH_ALERT_AFTER_FAILURES=2

# Cellar (Clever Cloud, API S3) — stockage des fichiers
# En dev : S3 local (S3Mock) (`docker compose up -d`, crée le bucket ci-dessous).
# En production : valeurs de l'add-on Cellar (CELLAR_ADDON_HOST — hôte nu ou URL —,
# CELLAR_ADDON_KEY_ID, CELLAR_ADDON_KEY_SECRET) ; le bucket est à créer au préalable.
CELLAR_ENDPOINT=http://localhost:9090
CELLAR_BUCKET=promotionnal-sourcing-dev
CELLAR_ACCESS_KEY_ID=dev
CELLAR_SECRET_ACCESS_KEY=dev

# Meilisearch (#112) — recherche hybride, index alimenté depuis PostgreSQL
# En dev : service `meilisearch` du docker-compose (`docker compose up -d`).
# MEILI_MASTER_KEY est lue par le compose ; valeurs factices, à ne jamais réutiliser en production.
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=dev-meili-master-key-change-me
# Poids du sémantique dans la recherche hybride (0 = mots-clés, 1 = vecteurs), défaut 0.5.
# SEARCH_SEMANTIC_RATIO=0.5
MEILI_MASTER_KEY=dev-meili-master-key-change-me

# IA — embeddings de la recherche sémantique, calculés par MEILISEARCH.
# Par défaut (AI_PROVIDER=huggingface), Meilisearch fait tourner un modèle multilingue
# lui-même : AUCUNE clé à fournir. Au premier usage il télécharge le modèle (~1 Go).
# En dev, pour rester léger (recherche par mots-clés seuls) :
# AI_EMBEDDINGS_ENABLED=false
# EN LOCAL, pour la recherche sémantique, préférer AI_PROVIDER=mistral (ci-dessous) :
# le téléchargement du modèle huggingface (~1 Go) échoue souvent sur un lien bridé
# (`HG_HUB failed`) et le cache du conteneur n'est pas persisté. huggingface reste le
# défaut en prod (réseau stable). Détail : docs/search.md § Vectorisation.
# Après tout changement de provider ou de modèle : `node ace search:reindex`.
#
# Provider : "huggingface" (défaut, local), "mistral" (API) ou "openai-compatible" (API).
AI_PROVIDER=huggingface
# HF_EMBED_MODEL=intfloat/multilingual-e5-base

# AI_PROVIDER=mistral : API Mistral (clé requise). Recommandé en local (voir ci-dessus).
MISTRAL_API_KEY=
# MISTRAL_EMBED_MODEL=mistral-embed

# Modèle de langage de la traduction automatique ET de la recherche par image : ce sont
# les clés présentes qui le désignent. ANTHROPIC_API_KEY renseignée -> Claude (API
# Anthropic, modèles 4.6 ou plus récents) ; sinon MISTRAL_API_KEY -> Mistral ; aucune
# des deux -> fonctions indisponibles. Sans rapport avec AI_PROVIDER ci-dessus, qui ne
# concerne que les embeddings (Claude n'a pas d'API d'embeddings).
# Attention : ajouter ou retirer ANTHROPIC_API_KEY change de fournisseur, donc de
# modèle et de clé d'idempotence : les traductions automatiques sont refaites au
# prochain passage (docs/i18n.md).
ANTHROPIC_API_KEY=
# CLAUDE_TRANSLATION_MODEL=claude-haiku-5-5
# CLAUDE_VISION_MODEL=claude-haiku-5-5

# Traduction automatique (job de queue). Désactivée par défaut.
AI_TRANSLATION_ENABLED=false
MISTRAL_TRANSLATION_MODEL=mistral-small-latest
# Tarif par million de tokens du modèle de traduction ACTIF (estimation du coût dans le
# back-office, laisser vide sinon). À ajuster quand on change de fournisseur ou de modèle.
AI_PRICE_INPUT_PER_MILLION=
AI_PRICE_OUTPUT_PER_MILLION=
AI_PRICE_CURRENCY=EUR
# Recherche par image (modèle vision du fournisseur actif, voir ci-dessus)
AI_VISION_ENABLED=false
# MISTRAL_VISION_MODEL=pixtral-12b-latest

# Driver OpenAI-compatible (AI_PROVIDER=openai-compatible) :
# OpenAI, Together, Groq, Ollama, vLLM, LM Studio… (protocole /embeddings).
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_EMBED_MODEL=text-embedding-3-small

# Rate limiting (login, inscription, mot de passe oublié) : `database` (table
# `rate_limits`, partagée entre instances) ou `memory` (tests, process unique).
LIMITER_STORE=database

# Passkeys (WebAuthn) — optionnel : dérivé de APP_URL par défaut.
# PASSKEY_RP_ID est le domaine (sans schéma ni port), PASSKEY_ORIGIN l'origine complète.
# Changer le RP ID invalide toutes les passkeys déjà enregistrées.
# PASSKEY_RP_ID=
# PASSKEY_ORIGIN=

# Connecteurs de flux fournisseurs (node ace supplier:import) — ACCÈS RÉELS.
# Ne jamais committer de valeur. Voir docs/supplier-feeds.md.
# Code distributeur des flux prix / stock / prix de marquage PF Concept
# (segment de l'URL fournie par PF Concept entre « pricefeed_ » et « _v3 »).
PFCONCEPT_FEED_CODE=
PASSOT_API_KEY=
INSPIRION_API_KEY=
# Makito : identifiants du compte client (POST /api/login renvoie le jeton).
MAKITO_EMAIL=
MAKITO_PASSWORD=
SUPPLIER_FEED_TIMEOUT_MS=
SUPPLIER_FEED_USER_AGENT=

# Produits sponsorisés — recharge du portefeuille publicitaire (Stripe).
# Optionnel : sans clé, la recharge en ligne est désactivée et l'équipe crédite
# les portefeuilles depuis le back-office. Clés de TEST uniquement ici.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Abonnements fournisseurs — souscription en ligne (Stripe Billing, docs/abonnements.md).
# Identifiants des prix récurrents mensuels créés dans le tableau de bord Stripe
# (Business 250 €, Premium 500 €). Optionnel : sans eux, l'abonnement est saisi
# par l'équipe. Même STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET que ci-dessus.
# STRIPE_PRICE_BUSINESS=
# STRIPE_PRICE_PREMIUM=

# Réception des mails entrants — réponses des fournisseurs aux demandes de devis
# (ADR 0005, docs/mail.md). Optionnel : sans ces valeurs, la réception est
# désactivée et les mails de demande partent sans Reply-To.
# INBOUND_MAIL_DOMAIN est le sous-domaine dont les MX pointent vers le prestataire.
# INBOUND_MAIL_SIGNING_KEY est le secret du webhook (whsec_…), INBOUND_MAIL_API_KEY
# la clé d'API qui lit le contenu des mails : à définir sur le web ET le worker.
# INBOUND_MAIL_PROVIDER=resend
# INBOUND_MAIL_DOMAIN=reply.promotionalsourcing.eu
# INBOUND_MAIL_SIGNING_KEY=
# INBOUND_MAIL_API_KEY=
# Valeurs par défaut : mail de 25 Mo, pièce jointe de 15 Mo, adresse relais
# valide 30 jours après la clôture ou l'expiration de la demande.
# INBOUND_MAIL_MAX_SIZE_MB=25
# INBOUND_MAIL_MAX_ATTACHMENT_SIZE_MB=15
# INBOUND_MAIL_GRACE_DAYS=30
