@let(title = t('emails.rfqReceived.title', { buyerName, brandName }))
@component('emails/layout', {
  title,
  locale,
  i18n,
  footer: t('emails.rfqReceived.footer'),
})
  <p>{{ t('emails.rfqReceived.body', { buyerName, rfqTitle, itemCount }) }}</p>
  @if(deadline)
    <p>{{ t('emails.rfqReceived.deadline', { deadline }) }}</p>
  @end

  <p><a class="button" href="{{ appUrl }}{{ rfqPath }}">{{ t('emails.rfqReceived.cta') }}</a></p>
@end
