<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }}</title>
    <style>
      body {
        font-family: sans-serif;
        background: #f4f4f5;
        margin: 0;
        padding: 0;
      }
      .wrapper {
        max-width: 600px;
        margin: 40px auto;
        background: #fff;
        border-radius: 8px;
        padding: 40px;
      }
      h1 {
        color: #111827;
        font-size: 24px;
        margin-bottom: 8px;
      }
      p {
        color: #374151;
        line-height: 1.6;
      }
      .button {
        display: inline-block;
        margin-top: 16px;
        padding: 12px 24px;
        background: #4032c8;
        color: #fff;
        text-decoration: none;
        border-radius: 6px;
      }
      .footer {
        margin-top: 32px;
        color: #9ca3af;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <h1>{{ title }}</h1>
      {{{ await $slots.main() }}}
      <div class="footer">
        {{-- Un mail qui invite à répondre (relais #223) ne dit pas le contraire. --}}
        @if(!replyable)
          {{ t('emails.layout.automatic') }}
        @end
        @if(footer)
          {{ footer }}
        @end
      </div>
    </div>
  </body>
</html>
