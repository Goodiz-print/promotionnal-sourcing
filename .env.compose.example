# Copier vers `.env.compose` (ignoré par git) : `cp .env.compose.example .env.compose`.
# Valeurs factices pour le développement local uniquement. Ne jamais réutiliser
# ces valeurs, ni les clés de production, dans ce fichier.

# Clé d'application : générer avec `node ace generate:key` (à coller ici).
APP_KEY=change-me-with-node-ace-generate-key
APP_URL=http://localhost:3333
LOG_LEVEL=info

# Base : service `postgres` du docker-compose (valeurs du compose de dev).
DB_USER=promotionnal-sourcing
DB_PASSWORD=promotionnal-sourcing
DB_DATABASE=promotionnal-sourcing_dev

# Stockage : service `s3` (S3Mock). Identifiants factices, non vérifiés par S3Mock.
CELLAR_BUCKET=promotionnal-sourcing-dev
CELLAR_ACCESS_KEY_ID=dev
CELLAR_SECRET_ACCESS_KEY=dev

# Recherche : service `elasticsearch` du docker-compose (URL surchargée par le compose).
ELASTICSEARCH_URL=http://elasticsearch:9200

# Mail : pas de serveur SMTP local dans le compose ; les envois échoueront
# proprement (erreur loggée) si la queue tente d'envoyer un mail.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM_ADDRESS=noreply@promotionalsourcing.eu
MAIL_FROM_NAME=PromotionalSourcing

# Embeddings coupés en local (recherche par mots-clés seuls) : sinon Elasticsearch appelle
# l'API Mistral (clé requise). Supprimer la ligne pour les activer.
AI_EMBEDDINGS_ENABLED=false
AI_TRANSLATION_ENABLED=false
MISTRAL_API_KEY=
